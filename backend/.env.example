ENV=dev

# Local PostgreSQL development database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradevalue
DB_USER=tradevalue
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE_SECONDS=300

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional full-match regex for Vercel preview frontend URLs.
# CORS_ORIGIN_REGEX=^https://tradevalue-frontend(-[a-z0-9-]+)?\.vercel\.app$

# Deployment environments should use a URL instead of the DB_* components.
# NONPROD_DATABASE_URL=postgresql://user:password@host:5432/tradevalue
# PROD_DATABASE_URL=postgresql://user:password@host:5432/tradevalue

# Optional when the AHL feed's automatic season selection is incorrect.
# AHL_SEASON_ID=
