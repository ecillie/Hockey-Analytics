ENV=dev

# Local PostgreSQL development database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradevalue
DB_USER=tradevalue
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=10

# Deployment environments should use a URL instead of the DB_* components.
# NONPROD_DATABASE_URL=postgresql://user:password@host:5432/tradevalue
# PROD_DATABASE_URL=postgresql://user:password@host:5432/tradevalue

# Optional when the AHL feed's automatic season selection is incorrect.
# AHL_SEASON_ID=
